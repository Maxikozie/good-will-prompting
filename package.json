{
  "name": "trustlayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TrustLayer: an MCP trust layer for SD Worx knowledge (Tectonic Hackathon Ghent)",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/api/server.ts",
    "mcp": "tsx src/mcp/server.ts",
    "ingest": "tsx src/core/ingest-cli.ts",
    "build": "vite build web",
    "start": "vite build web && tsx src/api/server.ts --prod",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
