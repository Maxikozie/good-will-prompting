# Copy to .env and fill in. Never commit .env.
ELEVENLABS_API_KEY=
GOOGLE_CLOUD_PROJECT=

# TrustLayer (all optional)
# Port for the dashboard + API (default 5173)
PORT=
# Pin "now" to replay the demo on another day, e.g. 2026-09-30T19:00:00Z
TRUSTLAYER_NOW=
# Use a different vault folder, e.g. for rehearsals (default ./vault)
TRUSTLAYER_VAULT_DIR=

# Brain (packages/brain). All optional.
# Real Postgres+pgvector (docker compose -f packages/brain/docker-compose.yml up -d). Empty = embedded PGlite in packages/brain/vault-brain/
DATABASE_URL=
# Where embedded PGlite keeps its data (default packages/brain/vault-brain/pglite)
BRAIN_PGLITE_DIR=

# Brain LLM layer. Provider: ollama (default) | anthropic | fake (replays test/fixtures/llm)
BRAIN_LLM_PROVIDER=
OLLAMA_HOST=
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=
# Optional: only needed when BRAIN_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
BRAIN_LLM_TIMEOUT_MS=

# MCP local stdio only: trusted identity/roles of the OS-authenticated launcher (required for npm run mcp).
# JSON object: {"id":"user:...","personId":"...","groups":["group:..."],"roles":["reader","contributor","verifier"]}
# See docs/security/MCP_AUTH.md for the explicit fictional demo configuration. No automatic identity fallback.
TRUSTLAYER_MCP_SESSION=
# JSON array of trusted principals/groups allowed to read the ENTIRE legacy vault; empty = deny.
TRUSTLAYER_MCP_VAULT_READERS=
