# Copy to .env and fill in. Never commit .env.
ELEVENLABS_API_KEY=
GOOGLE_CLOUD_PROJECT=

# TrustLayer (all optional)
# Port for the dashboard + API (default 5173)
PORT=
# Pin "now" to replay the demo on another day, e.g. 2026-09-30T19:00:00Z
TRUSTLAYER_NOW=
# Use a different vault folder, e.g. for rehearsals (default ./vault)
TRUSTLAYER_VAULT_DIR=
